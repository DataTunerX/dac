# Build stage — same Ubuntu base so native .so (e.g. pydantic-core) are glibc-compatible
FROM registry.cn-shanghai.aliyuncs.com/jamesxiong/python:3.13-ubuntu-timezone-amd64 AS uv

# Install uv (pip package)
RUN pip install uv && \
    uv --version

RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Install the project into /app
WORKDIR /app

RUN mkdir /app/sdks

COPY sdks/model_sdk-0.2.0-py3-none-any.whl /app/sdks/model_sdk-0.2.0-py3-none-any.whl

COPY sdks/skill_sdk-0.2.2-py3-none-any.whl /app/sdks/skill_sdk-0.2.2-py3-none-any.whl

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

# Install the project's dependencies using the lockfile and settings
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev --no-editable

# Then, add the rest of the project source code and install it
# Installing separately from its dependencies allows optimal layer caching
ADD . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

# Final stage — Ubuntu base
FROM registry.cn-shanghai.aliyuncs.com/jamesxiong/python:3.13-ubuntu-timezone-amd64

# Ensure app user exists (Ubuntu base image may not have it)
RUN id -u app &>/dev/null || (groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app)

# Install runtimes + LSP servers (single layer, clean up afterwards)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git gh curl \
    fd-find ripgrep libstdc++6 wget ca-certificates \
    golang-go nodejs npm openjdk-21-jre-headless clangd cargo \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    # gopls — Go language server (keep Go SDK: gopls needs 'go' at runtime)
    && go install golang.org/x/tools/gopls@latest \
    && cp /root/go/bin/gopls /usr/local/bin/ \
    && rm -rf /root/go \
    # basedpyright-langserver
    && npm install -g basedpyright \
    # vtsls support typescript and javascript
    && npm install -g @vtsls/language-server typescript \
    && npm cache clean --force \
    # jdtls — Eclipse JDT LS (latest snapshot)
    && wget -q "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz" -O /tmp/jdtls.tar.gz \
    && mkdir -p /opt/jdtls && tar xzf /tmp/jdtls.tar.gz -C /opt/jdtls \
    && ln -s /opt/jdtls/bin/jdtls /usr/local/bin/jdtls \
    && rm /tmp/jdtls.tar.gz \
   # rust-analyzer — Rust language server (via rustup)
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal \
    && /root/.cargo/bin/rustup component add rust-analyzer \
    && cp /root/.cargo/bin/rust-analyzer /usr/local/bin/ \
    && cp /root/.cargo/bin/rustup /usr/local/bin/ \
    && rm -rf /root/.cargo /root/.rustup \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/code

COPY --from=uv --chown=app:app /app/.venv /app/.venv

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"

COPY agent_card /app/agent_card

RUN rm -fr /app/.venv/lib/python3.13/site-packages/a2a/utils/telemetry.py

COPY telemetry.py /app/.venv/lib/python3.13/site-packages/a2a/utils/telemetry.py

ENTRYPOINT ["agent", "--port", "10100"]
