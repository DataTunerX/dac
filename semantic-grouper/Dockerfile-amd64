FROM python:3.12

RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -sf /usr/share/zoneinfo/America/New_York /etc/localtime && \
    echo "America/New_York" > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV TZ="America/New_York"

COPY requirements.txt /tmp

RUN pip3 install -r /tmp/requirements.txt

WORKDIR /app

ADD . /app

RUN pip3 install /app/sdks/model_sdk-0.2.0-py3-none-any.whl

RUN chmod +x /app/entrypoint-api.sh /app/entrypoint-worker.sh

# Default to API mode; override with entrypoint-worker.sh for Celery workers
ENTRYPOINT ["/bin/bash", "/app/entrypoint-api.sh"]
