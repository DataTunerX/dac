        },
        {
            "id": "SemanticDomain_002",
            "name": "组织架构管理",
            "labels": [
                "SemanticDomain"
            ],
            "properties": {
                "englishName": "Organization Management",
                "description": "管理公司的部门层级结构、办公地点和部门负责人信息。"
            }
        },
        {
            "id": "SemanticDomain_003",
            "name": "人力资源管理",
            "labels": [
                "SemanticDomain"
            ],
            "properties": {
                "englishName": "Human Resource Management",
                "description": "管理员工的全生命周期信息，包括个人资料、雇佣关系、职位、薪资和部门归属。"
            }
        },
        {
            "id": "SemanticDomain_004",
            "name": "项目管理",
            "labels": [
