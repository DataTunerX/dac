# stage 1
# Build stage with explicit platform specification
FROM python:3.13-slim AS uv

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install uv

# Install the project into /app
WORKDIR /app

RUN mkdir /app/sdks

COPY sdks/model_sdk-0.2.0-py3-none-any.whl /app/sdks/model_sdk-0.2.0-py3-none-any.whl

COPY sdks/skill_sdk-0.3.1-py3-none-any.whl /app/sdks/skill_sdk-0.3.1-py3-none-any.whl

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Install the project's dependencies using the lockfile and settings
RUN --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev --no-editable

# Then, add the rest of the project source code and install it
# Installing separately from its dependencies allows optimal layer caching
ADD . /app
RUN uv sync --frozen --no-dev --no-editable


# stage 2
FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -sf /usr/share/zoneinfo/America/New_York /etc/localtime && \
    echo "America/New_York" > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
ENV TZ="America/New_York"

COPY --from=uv --chown=app:app /app/.venv /app/.venv

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"

# The built-in default namespace lives in /app/skills/default/.
# Repo layout is skills/default/*.zip, so copy that dir (not skills/) to avoid
# nesting as /app/skills/default/default/.
RUN mkdir -p /app/skills/default
COPY skills/default /app/skills/default

# Place executables in the environment at the front of the path
ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["skill-hub", "--port", "8000"]