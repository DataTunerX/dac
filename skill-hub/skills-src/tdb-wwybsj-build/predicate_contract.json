    "artifact": {
      "id_prefix": "wwybsj.artifact.",
      "object_type": "collection_artifact"
    },
    "term": {
      "id_prefix": "wwybsj.term.",
      "object_type": null
    }
  },
  "object_types": {
    "category": "artifact_type",
