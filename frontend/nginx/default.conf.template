# Only set "Connection: upgrade" when client requests upgrade (WebSocket).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      keep-alive;
}

server {
  listen 3000;
  server_name _;

  # Large streaming responses / SSE
  proxy_buffering off;
  gzip off;

  # Proxy API directly to backend (runtime-configurable)
  location /api/v1/ {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Streaming/SSE friendly: don't buffer request/response, keep long timeouts.
    proxy_request_buffering off;
    proxy_cache off;
    proxy_buffering off;
    proxy_set_header Accept-Encoding "";
    add_header X-Accel-Buffering no always;

    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_pass ${BACKEND_URL};
  }

  # OpenAI-compatible endpoints are mounted at `/v1/*` in dac-apiserver.
  location /v1/ {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Streaming/SSE friendly: don't buffer request/response, keep long timeouts.
    proxy_request_buffering off;
    proxy_cache off;
    proxy_buffering off;
    proxy_set_header Accept-Encoding "";
    add_header X-Accel-Buffering no always;

    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_pass ${BACKEND_URL};
  }

  # Next.js static assets (optional optimization)
  location /_next/static/ {
    alias /app/.next/static/;
    access_log off;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Everything else -> Next.js server
  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_pass http://127.0.0.1:3001;
  }
}

