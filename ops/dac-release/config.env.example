# Copy to /etc/dac-release/config.env on the build machine.
# Do not put passwords or API keys in this file.

DAC_REGISTRY=10.124.48.120/dac
DAC_KUBE_CONTEXT=test-cluster
DAC_NAMESPACE=dac
DAC_HELM_RELEASE=dac
DAC_BUILDER=dac-amd64-builder

# Build-host paths. These match the provisioned host at 10.124.48.168.
DAC_REPO_ROOT=/data/dac-build/source/dac
DAC_STATE_DIR=/data/dac-build/state
DAC_LOCK_FILE=/data/dac-build/state/dac-release.lock

# Optional timeout override.
# DAC_HELM_TIMEOUT=20m
